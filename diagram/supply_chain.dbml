Project supply_chain {
  database_type: 'PostgreSQL'
  Note: 'Система управління ланцюгами постачання. Soft delete: deleted_at IS NULL => запис активний'
}

Enum user_role {
  admin
  manager
  sales
  warehouse_worker
}

Enum product_category {
  electronics
  clothing
}

Enum order_status {
  new
  confirmed
  shipped
  delivered
  cancelled
}

Enum supply_status {
  planned
  in_transit
  delivered
  rejected
}

Enum shipment_status {
  pending
  shipped
  delivered
}

//Системні
Table app_user {
  id integer [pk, increment]
  username varchar(50) [not null, unique]
  password_hash varchar(255) [not null]
  role user_role [not null]
  employee_id integer [unique, note: '1:1 з employee']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Користувачі системи; на них посилаються updated_by та audit_log.changed_by'
}

Table audit_log {
  id bigint [pk, increment]
  table_name varchar(63) [not null]
  record_id varchar(100) [not null]
  operation varchar(12) [not null, note: 'INSERT | UPDATE | DELETE | SOFT_DELETE | RESTORE']
  old_data jsonb
  new_data jsonb
  changed_by integer [ref: > app_user.id]
  changed_at timestamptz [not null, default: `now()`]

  indexes {
    (table_name, record_id) [name: 'ix_audit_record']
  }
}

//Структура компанії
Table department {
  id integer [pk, increment]
  name varchar(255) [not null, unique]
  phone varchar(20)
  head_employee_id integer [not null, unique, note: 'Очолює (1:1), FK DEFERRABLE']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by integer [ref: > app_user.id]
}

Table employee {
  id integer [pk, increment]
  full_name varchar(255) [not null]
  position varchar(100) [not null]
  salary "numeric(10,2)" [not null]
  hire_date date [not null, default: `current_date`]
  department_id integer [not null, ref: > department.id, note: 'Працює']
  mentor_id integer [ref: > employee.id, note: 'Ментор (рекурсивний зв\'язок)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by integer [ref: > app_user.id]
  deleted_at timestamptz [note: 'soft delete']

  indexes {
    department_id [name: 'ix_employee_department']
  }
}

Ref: department.head_employee_id - employee.id
Ref: app_user.employee_id - employee.id [delete: set null]

//Клієнти та продажі
Table customer {
  id integer [pk, increment]
  full_name varchar(255) [not null]
  phone varchar(20)
  email varchar(255)
  address text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by integer [ref: > app_user.id]
  deleted_at timestamptz [note: 'soft delete']

  indexes {
    phone [type: hash, name: 'ix_customer_phone_hash']
  }
}

Table customer_order {
  order_number integer [pk, increment]
  customer_id integer [not null, ref: > customer.id]
  employee_id integer [not null, ref: > employee.id, note: 'Обробляє']
  order_date timestamptz [not null, default: `now()`]
  status order_status [not null, default: 'new']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by integer [ref: > app_user.id]

  indexes {
    (status, order_date) [name: 'ix_order_status_date']
  }
}

Table order_item {
  order_number integer [not null, ref: > customer_order.order_number, note: 'ON DELETE CASCADE']
  line_number integer [not null, note: 'частковий ключ слабкої сутності']
  product_sku varchar(50) [not null, ref: > product.sku]
  quantity integer [not null]
  unit_price "numeric(10,2)" [not null, note: 'ціна на момент продажу']

  indexes {
    (order_number, line_number) [pk]
  }
}

//Товари
Table product {
  sku varchar(50) [pk]
  name varchar(255) [not null]
  price "numeric(10,2)" [not null]
  category product_category [not null, note: 'дискримінатор спеціалізації']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by integer [ref: > app_user.id]
  deleted_at timestamptz [note: 'soft delete']
}

Table electronics {
  product_sku varchar(50) [pk]
  warranty_months integer [not null]
}

Table clothing {
  product_sku varchar(50) [pk]
  size varchar(20) [not null]
  material varchar(100) [not null]
}

Ref: electronics.product_sku - product.sku [delete: cascade]
Ref: clothing.product_sku - product.sku [delete: cascade]

//Постачання
Table supplier {
  edrpou varchar(10) [pk]
  company_name varchar(255) [not null]
  phone varchar(20)
  email varchar(255)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by integer [ref: > app_user.id]
  deleted_at timestamptz [note: 'soft delete']
}

Table contract {
  contract_number varchar(50) [pk]
  supplier_edrpou varchar(10) [not null, ref: > supplier.edrpou, note: 'Підписує']
  sign_date date [not null]
  expiry_date date [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by integer [ref: > app_user.id]
  deleted_at timestamptz [note: 'soft delete']
}

Table contract_item {
  contract_number varchar(50) [not null, ref: > contract.contract_number, note: 'ON DELETE CASCADE']
  product_sku varchar(50) [not null, ref: > product.sku]
  agreed_price "numeric(10,2)" [not null]
  max_quantity integer [note: 'NULL = без ліміту']

  indexes {
    (contract_number, product_sku) [pk]
  }
}

Table warehouse {
  id integer [pk, increment]
  name varchar(100) [not null, unique]
  address text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by integer [ref: > app_user.id]
  deleted_at timestamptz [note: 'soft delete']
}

Table supply {
  id integer [pk, increment]
  contract_number varchar(50) [not null]
  product_sku varchar(50) [not null]
  warehouse_id integer [not null, ref: > warehouse.id]
  delivery_date date [not null]
  quantity integer [not null]
  status supply_status [not null, default: 'planned']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by integer [ref: > app_user.id]

  indexes {
    (contract_number, product_sku) [name: 'ix_supply_contract_product']
    delivery_date [name: 'ix_supply_delivery_date']
  }
  Note: 'Тернарний зв'язок "Поставка": контракт x товар x склад'
}

Ref: supply.(contract_number, product_sku) > contract_item.(contract_number, product_sku)

Table warehouse_stock {
  warehouse_id integer [not null, ref: > warehouse.id]
  product_sku varchar(50) [not null, ref: > product.sku]
  quantity integer [not null, default: 0]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (warehouse_id, product_sku) [pk]
  }
  Note: 'Залишки; змінюються лише тригерами supply та shipment'
}

Table shipment {
  id integer [pk, increment]
  order_number integer [not null, unique]
  warehouse_id integer [not null, ref: > warehouse.id]
  shipped_at timestamptz
  tracking_number varchar(50)
  status shipment_status [not null, default: 'pending']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by integer [ref: > app_user.id]
}

Ref: shipment.order_number - customer_order.order_number
